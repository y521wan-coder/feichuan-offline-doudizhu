[Unit]
Description=Feichuan 2.3 online multiplayer service (rootless pod)
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/online
ExecStart=%h/online/online-start.sh
ExecStop=%h/online/online-stop.sh
TimeoutStartSec=180
TimeoutStopSec=120

[Install]
WantedBy=default.target