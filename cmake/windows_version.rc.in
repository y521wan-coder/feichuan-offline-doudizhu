#pragma code_page(65001)
#include <windows.h>

1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@FPDZ_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@FPDZ_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "飞船\0"
            VALUE "FileDescription", "@FPDZ_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@FPDZ_VERSION_PATCH@.0\0"
            VALUE "InternalName", "@FPDZ_INTERNAL_NAME@\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 飞船\0"
            VALUE "OriginalFilename", "@FPDZ_ORIGINAL_FILENAME@\0"
            VALUE "ProductName", "飞船斗地主\0"
            VALUE "ProductVersion", "@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@FPDZ_VERSION_PATCH@.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
